# Copy to .env for local use. Placeholders only - never commit real values.
# Endpoint lines are commented out so a copied file still runs offline; uncomment and fill in to use Azure.

# --- Azure AI Foundry / Azure OpenAI (either the project endpoint or the OpenAI endpoint) ---
# AZURE_AI_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
# AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# Fallback only; prefer managed identity / `az login`. Leave empty.
AZURE_OPENAI_API_KEY=

# --- Azure AI Search ---
# AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=policy-docs
AZURE_SEARCH_SEMANTIC_RANKER=true
AZURE_SEARCH_MIN_RERANKER_SCORE=1.5
AZURE_SEARCH_API_KEY=

# --- Azure AI Content Safety ---
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<content-safety>.cognitiveservices.azure.com/
CONTENT_SAFETY_BLOCK_SEVERITY=4
AZURE_CONTENT_SAFETY_KEY=

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
POLICYAGENT_TRACE_CONSOLE=0

# --- Agent ---
POLICYAGENT_MODE=auto
POLICYAGENT_TOP_K=4
